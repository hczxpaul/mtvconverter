# 仅占位值；真实配置写入本地 .env（已加入 .gitignore），禁止提交密钥。
# ConfigService 在启动时集中校验这些变量，缺失或非法即快速失败。

# 外部可执行依赖（为空时使用 PATH 上的可执行文件）
MTVC_FFMPEG_PATH=
MTVC_FFPROBE_PATH=

# UVR 分离运行时与模型权重（允许联网按需下载，SHA256 校验）
# 首次使用执行 npm run resources:setup-uvr 自动准备 Python 运行时与默认模型
MTVC_UVR_ROOT=
MTVC_UVR_PYTHON=
MTVC_UVR_SEPARATOR_SCRIPT=
MTVC_UVR_MODEL_DIR=
MTVC_UVR_MODEL=UVR-MDX-NET-Inst_HQ_3
MTVC_MODEL_BASE_URL=
MTVC_MODEL_SHA256=
# 应用可写数据目录（默认与 Electron userData 一致）
MTVC_USER_DATA=

# 中文字体目录（烧录字幕需要带 libass 的 FFmpeg 构建）
MTVC_FONTS_DIR=

# 运行目录与日志
MTVC_CACHE_DIR=
MTVC_LOG_LEVEL=info
MTVC_MAX_CONCURRENT_JOBS=1

# 歌词服务（仅发送用户主动提供的歌曲 ID，不上传媒体文件）
MTVC_LYRICS_BASE_URL=https://lyric.photix.cc
MTVC_LYRICS_TIMEOUT_MS=8000

# 预览代理：必须显式 IPv4，避免 ::1 被 RST
MTVC_PREVIEW_HOST=127.0.0.1
MTVC_PREVIEW_IDLE_TTL_MS=300000

# 详细模式（默认关闭；打开后恢复完整信息密度）
MTVC_DETAILED_MODE=false
