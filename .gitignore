# 依赖与构建产物（build/ 内含打包必需的 entitlements.mac.plist，不忽略）
node_modules/
# 换架构 / 换平台时留下的依赖备份，动辄几百 MB，绝不入库
node_modules.*/
dist/
release/
# 发布归档（安装包 + 源码 zip + 校验清单），按需上传，不入库
archive/
*.tsbuildinfo

# 本机状态与撤销备份（.trash/ 含旧 .app 打包备份，约 17 GB）
.DS_Store
.trash/
*.log
# NAS 侧删除失败留下的占位文件
*.smbdelete
.tmp-vitest/

# 私有配置与密钥
.env

# 测试素材与转换产物（体积大、含版权 MV，不入库）
testdata/
output/
coverage/

# 随包二进制 / 模型 / 字体（按清单按需下载，见 resources/manifest.json）
resources/bin/
resources/models/
resources/fonts/
!resources/manifest.json

# 散落在仓库根目录的构建 CSS（如 index-uxSyr7m_.css）
/index-*.css
